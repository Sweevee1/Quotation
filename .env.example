# REQUIRED. WebUI bootstrap password (the server refuses to start in production if empty or weak).
# Generate one: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Only used to seed the hashed password in the DB on first run.
# Change the real password from the Settings page afterward; this value is ignored once seeded.
WEBUI_PASSWORD=

# REQUIRED. Secret used to sign the WebUI session cookie. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the server listens on (also serves the built WebUI in production).
PORT=8766

# Directory where the SQLite database file is stored.
# In Docker this is bind-mounted; locally it defaults to ./data.
DATA_DIR=./data

# Reverse-proxy hops to trust for X-Forwarded-* (client IP used by the login rate limit).
# 0 (default) = reached directly, e.g. by LAN IP. Set 1 only if exactly one proxy/tunnel sits in front
# AND overwrites X-Forwarded-For; otherwise clients can spoof their IP and bypass the login limit.
TRUST_PROXY=0
